# ---------------------------------------------------------------------------
# ECO-SYNC: THE BREACH — environment configuration
# Copy this file to `.env` for local development. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Session lifetime in hours (optional, default: 12)
SESSION_TTL_HOURS="12"

# First-run seed token (optional but recommended). Required by the /admin seed
# form while zero operator accounts exist; unset means that path stays locked
# and the event must be seeded via scripts/seed-event.ts.
FIRST_RUN_SEED_TOKEN=""
